# Python
__pycache__/
*.pyc

# Local tooling and scratch
.claude/
*.log
*.tmp

# runs/: only the checkpoints behind the shipped models are tracked (see README,
# "Reproduce the models"); everything a tool or a new training run writes stays local.
runs/*
!runs/columns_base/
runs/columns_base/*
!runs/columns_base/stage2/
runs/columns_base/stage2/*
!runs/columns_base/stage2/last.pt
!runs/columns_base/stage2/audit.json
!runs/columns_final/
runs/columns_final/*
!runs/columns_final/stage2/
runs/columns_final/stage2/*
!runs/columns_final/stage2/last.pt
!runs/columns_final/stage2/audit.json
!runs/edges_seed/
runs/edges_seed/*
!runs/edges_seed/last.pt
!runs/edges_seed/audit.json
!runs/edges_final_a/
runs/edges_final_a/*
!runs/edges_final_a/last.pt
!runs/edges_final_a/audit.json
!runs/edges_final_b/
runs/edges_final_b/*
!runs/edges_final_b/last.pt
!runs/edges_final_b/audit.json

# TensorBoard event files are run history, not source
*.tfevents.*
!runs/edges_oct_a/
runs/edges_oct_a/*
!runs/edges_oct_a/last.pt
!runs/edges_oct_a/audit.json
!runs/edges_oct_b/
runs/edges_oct_b/*
!runs/edges_oct_b/last.pt
!runs/edges_oct_b/audit.json
!runs/edges_r3_a/
runs/edges_r3_a/*
!runs/edges_r3_a/last.pt
!runs/edges_r3_a/audit.json
!runs/edges_r3_b/
runs/edges_r3_b/*
!runs/edges_r3_b/last.pt
!runs/edges_r3_b/audit.json
